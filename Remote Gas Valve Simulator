### `sentinel.py`

```python
#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
import socket
import sys
from pathlib import Path

import psutil


APP_NAME = "Nexora Sentinel"
VERSION = "1.0.0"


def system_health():
    memory = psutil.virtual_memory()
    disk = psutil.disk_usage(Path.cwd())

    return {
        "cpu_percent": psutil.cpu_percent(interval=1),
        "memory_percent": memory.percent,
        "disk_percent": disk.percent,
    }


def listening_ports():
    ports = set()

    for connection in psutil.net_connections(kind="tcp"):
        if connection.status == psutil.CONN_LISTEN and connection.laddr:
            ports.add(connection.laddr.port)

    return sorted(ports)


def file_hash(path):
    digest = hashlib.sha256()

    with open(path, "rb") as file:
        for chunk in iter(lambda: file.read(65536), b""):
            digest.update(chunk)

    return digest.hexdigest()


def integrity_scan(directory):
    root = Path(directory)

    if not root.exists():
        raise FileNotFoundError(directory)

    results = {}

    for path in root.rglob("*"):
        if path.is_file():
            try:
                results[str(path)] = file_hash(path)
            except (PermissionError, OSError):
                continue

    return results


def create_report(directory=None):
    report = {
        "application": APP_NAME,
        "version": VERSION,
        "system": system_health(),
        "network": {
            "listening_tcp_ports": listening_ports()
        },
    }

    if directory:
        report["integrity"] = integrity_scan(directory)

    return report


def print_health():
    health = system_health()

    print(f"\n{APP_NAME} {VERSION}")
    print("─" * 38)
    print("\nSYSTEM HEALTH\n")

    for key, value in health.items():
        label = key.replace("_", " ").title()
        print(f"{label:<18} {value:.1f}%")


def print_ports():
    ports = listening_ports()

    print(f"\n{APP_NAME}")
    print("─" * 38)
    print("\nLISTENING TCP PORTS\n")

    if not ports:
        print("No listening TCP ports detected.")
        return

    for port in ports:
        print(f"- {port}")


def main():
    parser = argparse.ArgumentParser(
        prog="sentinel",
        description="Nexora Sentinel system monitoring and security auditing CLI.",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("health", help="Display system health.")
    subparsers.add_parser("ports", help="List listening TCP ports.")

    audit = subparsers.add_parser(
        "audit",
        help="Run a complete system audit."
    )
    audit.add_argument(
        "--path",
        default=None,
        help="Directory to include in the integrity scan."
    )

    report = subparsers.add_parser(
        "report",
        help="Generate a JSON report."
    )
    report.add_argument(
        "--output",
        default="nexora-report.json",
        help="Output file."
    )
    report.add_argument(
        "--path",
        default=None,
        help="Directory to include in the integrity scan."
    )

    args = parser.parse_args()

    try:
        if args.command == "health":
            print_health()

        elif args.command == "ports":
            print_ports()

        elif args.command == "audit":
            data = create_report(args.path)
            print(json.dumps(data, indent=2))

        elif args.command == "report":
            data = create_report(args.path)

            with open(args.output, "w", encoding="utf-8") as file:
                json.dump(data, file, indent=2)

            print(f"Report written to: {args.output}")

    except (OSError, FileNotFoundError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
```

